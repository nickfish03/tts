---
title: "Contact - Toad Town Services"
description: "Contact Toad Town Services for tech support, IT, and church audio/video help in Rhinelander and northern Wisconsin."
permalink: /contact.html
---
{% extends "base.njk" %}
{% from "contact-box.njk" import contactBox %}
{% from "page-header.njk" import pageHeader %}

{% block styles %}
    <style>
        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .contact-form {
            background-color: rgba(73, 53, 41, 0.6);
            padding: 40px;
            border-radius: 10px;
            border: 1px solid #6cc86c;
            margin-bottom: 30px;
            backdrop-filter: blur(10px);
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #6cc86c;
        }
        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 12px;
            border: 2px solid #6cc86c;
            border-radius: 5px;
            font-size: 1rem;
            box-sizing: border-box;
            background-color: rgba(43, 31, 26, 0.6);
            color: #faf3e8;
        }
        .form-group input:focus,
        .form-group textarea:focus,
        .form-group select:focus {
            border-color: #6cc86c;
            background-color: rgba(43, 31, 26, 0.8);
        }
        .form-group input::placeholder { color: #c9bcae; opacity: 1; }
        .form-group textarea {
            height: 120px;
            resize: vertical;
        }
        .review-btn {
            display: inline-block;
            background-color: #6cc86c;
            color: #2b1f1a;
            font-weight: bold;
            text-decoration: none;
            padding: 12px 24px;
            border-radius: 5px;
        }
        .review-btn:hover { background-color: #6fd36f; }
        .review-box { text-align: center; }
        .submit-btn {
            background: linear-gradient(135deg, #5cb85c 0%, #6cc86c 100%);
            color: #2b1f1a;
            padding: 15px 30px;
            border: none;
            border-radius: 5px;
            font-size: 1.125rem;
            cursor: pointer;
            width: 100%;
            font-weight: bold;
        }
        .submit-btn:hover {
            background: linear-gradient(135deg, #6cc86c 0%, #6dc76d 100%);
        }
        .contact-info {
            background-color: rgba(73, 53, 41, 0.6);
            padding: 30px;
            border-radius: 10px;
            text-align: center;
            border: 1px solid #6cc86c;
            backdrop-filter: blur(10px);
        }
        .phone {
            font-size: 1.5rem;
            font-weight: bold;
            color: #6cc86c;
            margin-bottom: 15px;
        }
        .reveal-checkbox-container {
            background-color: rgba(90, 44, 44, 0.5);
            border: 2px solid #6cc86c;
            padding: 15px;
            margin: 15px auto;
            border-radius: 5px;
            display: inline-block;
        }
        .contact-details {
            display: none;
            margin-top: 15px;
            padding-top: 15px;
            border-top: 2px solid #6cc86c;
        }
        .hp-field {
            position: absolute;
            left: -9999px;
            width: 1px;
            height: 1px;
            overflow: hidden;
        }
        .form-note {
            font-size: 0.9375rem;
            color: #f0e5d8;
            margin: 0 0 20px;
        }
        .help-text {
            font-size: 0.875rem;
            color: #c9bcae;
            margin: 6px 0 0;
        }
        .form-status {
            margin-top: 15px;
            padding: 12px 15px;
            border-radius: 5px;
            display: none;
        }
        .form-status.show { display: block; }
        .form-status.error {
            background-color: rgba(90, 44, 44, 0.7);
            border: 2px solid #e8a0a0;
        }
        .form-status.success {
            background-color: rgba(43, 31, 26, 0.6);
            border: 2px solid #6cc86c;
        }
        .cf-turnstile { margin-bottom: 20px; }
        .submit-btn:disabled {
            opacity: 0.6;
            cursor: wait;
        }
        .form-group input:invalid:not(:placeholder-shown):not(:focus),
        .form-group textarea:invalid:not(:focus):not(:placeholder-shown) {
            border-color: #e8a0a0;
        }
        @media (max-width: 600px) {
            nav a { margin: 0 15px; font-size: 1rem; }
            .contact-form { padding: 20px; }
        }
    </style>
{% endblock %}

{% block content %}
    <div class="container">
        {{ pageHeader("Contact Toad Town Services", "Let me know how I can help!") }}

        <div class="contact-form">
            <form id="contact-form" method="POST" data-endpoint="aHR0cHM6Ly9mb3Jtc3ByZWUuaW8vZi94eWtrZ2Frdg==">
                <p class="form-note">Fields marked * are required. Please don't include passwords or account numbers in your message.</p>

                <input type="hidden" name="_subject" id="f-subject" value="Website inquiry - Toad Town Services">
                <input type="hidden" name="fill-time-seconds" id="f-fill-time" value="">
                <div class="hp-field" aria-hidden="true">
                    <label for="f-website">Leave this field empty</label>
                    <input id="f-website" type="text" name="_gotcha" tabindex="-1" autocomplete="off">
                </div>
                <div class="form-group">
                    <label for="f-name">Your name *</label>
                    <input id="f-name" type="text" name="name" autocomplete="name" maxlength="100" required>
                </div>

                <div class="form-group">
                    <label for="f-email">Your email *</label>
                    <input id="f-email" type="email" name="email" autocomplete="email" maxlength="150" required>
                </div>

                <div class="form-group">
                    <label for="f-phone">Your phone (optional)</label>
                    <input id="f-phone" type="tel" name="phone" autocomplete="tel" maxlength="30">
                </div>

                <div class="form-group">
                    <label for="f-location">Your location *</label>
                    <input id="f-location" type="text" name="location" autocomplete="address-level2" maxlength="100" placeholder="Town or area (e.g., Rhinelander, Minocqua, Wausau)" required>
                </div>

                <div class="form-group">
                    <label for="f-service-type">Type of service needed *</label>
                    <select id="f-service-type" name="service-type" required>
                        <option value="">-- Please select --</option>
                        <optgroup label="Home">
                            <option value="Computer Repair/Troubleshooting">Computer repair or troubleshooting</option>
                            <option value="Virus/Malware Removal">Virus or malware removal</option>
                            <option value="Internet/WiFi">Internet or WiFi problems</option>
                            <option value="Smart Home/TV/Streaming">Smart home, TV, or streaming setup</option>
                            <option value="Printer Setup/Issues">Printer setup or issues</option>
                            <option value="Data Backup/Recovery">Data backup or recovery</option>
                            <option value="Email/Account Setup">Email, passwords, or account setup</option>
                            <option value="Computer Training/Tutoring">Phone, tablet, or computer training</option>
                        </optgroup>
                        <optgroup label="Business, Nonprofit & Church">
                            <option value="Office Network/Computers">Office computers or network</option>
                            <option value="Website/Domain/Online Presence">Website, domain, or Google Business</option>
                            <option value="Security Cameras">Security cameras</option>
                            <option value="Ongoing Tech Support">Ongoing tech support (someone on file)</option>
                            <option value="Review a Quote">Second opinion on a tech quote</option>
                        </optgroup>
                        <optgroup label="Audio & Video">
                            <option value="Sound System">Sound system setup or troubleshooting</option>
                            <option value="Livestream/Projection">Livestreaming or projection</option>
                            <option value="Event Audio">Event audio</option>
                        </optgroup>
                        <option value="Other">Something else</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="f-timeline">Timeline/urgency *</label>
                    <select id="f-timeline" name="timeline" required>
                        <option value="">-- Please select --</option>
                        <option value="ASAP - Emergency">ASAP - Emergency</option>
                        <option value="This week">This week</option>
                        <option value="Within 2 weeks">Within 2 weeks</option>
                        <option value="Within a month">Within a month</option>
                        <option value="No rush - flexible timeline">No rush - flexible timeline</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="f-message">Please describe your project or issue *</label>
                    <textarea id="f-message" name="message" rows="6" minlength="20" maxlength="3000" placeholder="What's going on? Include the device or system involved, what you've already tried, and anything else that helps." required></textarea>
                    <p class="help-text">A few sentences is plenty.</p>
                </div>

                <div class="cf-turnstile" data-sitekey="0x4AAAAAAGPJPoiMwWi9Vipr" data-theme="dark"></div>

                <button type="submit" class="submit-btn" id="submit-btn">Send Message</button>
                <div class="form-status" id="form-status" role="status" aria-live="polite" tabindex="-1"></div>
                <noscript><p class="form-note">This form needs JavaScript. Please enable it to send a message.</p></noscript>
            </form>
        </div>

        <div class="contact-form">
            <h2>Contact Toad Town Services</h2>
            <p>The best way to reach me is by email. I typically reply within 24 hours.</p>
            <p>If you'd prefer to call, please leave a message and I'll get back to you.</p>
            <p><strong>Hours:</strong> Monday - Friday, 8:00 AM - 4:00 PM</p>
            <p><strong>Serving:</strong> Rhinelander and the Northwoods, with travel to the Wausau area</p>

            <div class="reveal-checkbox-container">
                <label>
                    <input type="checkbox" id="revealContact" onchange="toggleContact()">
                    <span>Check here to reveal contact information</span>
                </label>
                <div class="contact-details" id="contactDetails">
                    <div class="phone" id="phoneDisplay"></div>
                    <p><strong>Email:</strong> <span id="emailDisplay"></span></p>
                </div>
            </div>
        </div>

        <div class="contact-form review-box">
            <h2>Worked With Me Before?</h2>
            <p>If I've helped you out, I'd be grateful for a short Google review. Reviews help neighbors in the Northwoods find honest, local tech help, and they mean a lot to a small business like mine. A sentence or two is plenty.</p>
            <p><a class="review-btn" href="https://g.page/r/Cfulcy6YYU_ZEAE/review" target="_blank" rel="noopener">Leave a Google review</a></p>
        </div>
    </div>

    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script>
        (function () {
            var form = document.getElementById('contact-form');
            if (!form) return;
            var status = document.getElementById('form-status');
            var btn = document.getElementById('submit-btn');
            var started = Date.now();
            var MIN_SECONDS = 4; // faster than this is almost certainly a bot

            function showStatus(kind, html) {
                status.className = 'form-status show ' + kind;
                status.innerHTML = html;
                status.focus();
            }

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                var seconds = Math.round((Date.now() - started) / 1000);
                document.getElementById('f-fill-time').value = String(seconds);

                var service = document.getElementById('f-service-type').value;
                document.getElementById('f-subject').value =
                    'Website inquiry' + (service ? ': ' + service : '') + ' - Toad Town Services';

                // Honeypot filled or form completed impossibly fast: pretend success, send nothing.
                if (document.getElementById('f-website').value || seconds < MIN_SECONDS) {
                    form.reset();
                    showStatus('success', '<strong>Thanks!</strong> Your message was sent. I typically reply within 24 hours.');
                    return;
                }

                // Cloudflare Turnstile adds this hidden field once its check passes.
                var tsField = form.querySelector('[name="cf-turnstile-response"]');
                if (!tsField || !tsField.value) {
                    showStatus('error', 'Please wait a moment for the security check to finish, then press Send again.');
                    return;
                }

                btn.disabled = true;
                btn.textContent = 'Sending...';
                status.className = 'form-status';

                fetch(atob(form.dataset.endpoint), {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { 'Accept': 'application/json' }
                }).then(function (res) {
                    if (!res.ok) throw new Error('bad status ' + res.status);
                    form.reset();
                    showStatus('success', '<strong>Thanks!</strong> Your message was sent. I typically reply within 24 hours.');
                }).catch(function () {
                    showStatus('error', "Sorry, that didn't go through. Please try again, or use <strong>Check here to reveal contact information</strong> below to call or email me directly.");
                }).then(function () {
                    if (window.turnstile) window.turnstile.reset(); // tokens are single-use
                    btn.disabled = false;
                    btn.textContent = 'Send Message';
                });
            });
        })();
    </script>
{% endblock %}
