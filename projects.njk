---
title: "Projects - Toad Town Services"
description: "Examples of recent tech, IT, and church audio/video work by Toad Town Services in Rhinelander and northern Wisconsin."
permalink: /projects/index.html
---
{% extends "base.njk" %}
{% from "contact-box.njk" import contactBox %}

{% block styles %}
    <style>
        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 20px;
        }
        .page-header {
            text-align: center;
            background-color: rgba(73, 53, 41, 0.6);
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 30px;
            border: 1px solid #5cb85c;
            backdrop-filter: blur(10px);
        }
        h1 {
            color: #5cb85c;
            border-bottom: 3px solid #5cb85c;
            padding-bottom: 10px;
        }
        .page-header p { color: #f0e5d8; }
        .logo { width: 75px; height: auto; }
        .project-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
            gap: 25px;
        }
        .project-card {
            background-color: rgba(73, 53, 41, 0.6);
            border-left: 4px solid #5cb85c;
            border-radius: 5px;
            overflow: hidden;
            backdrop-filter: blur(10px);
        }
        .project-card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            display: block;
        }
        .project-body { padding: 20px; }
        .project-category {
            color: #c4a882;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .project-card h2 {
            color: #5cb85c;
            margin: 5px 0 15px;
            font-size: 21px;
        }
        .project-card h3 {
            color: #faf3e8;
            font-size: 15px;
            margin: 12px 0 4px;
        }
        .project-card p {
            color: #f0e5d8;
            margin: 0;
            line-height: 1.5;
        }
        .project-card a { color: #5cb85c; font-weight: bold; }
        .cta {
            text-align: center;
            background-color: rgba(73, 53, 41, 0.6);
            padding: 20px;
            margin: 30px 0 0;
            border-radius: 5px;
            border: 1px solid #5cb85c;
        }
        .cta a { color: #5cb85c; font-weight: bold; }
        .cta p { color: #f0e5d8; }
        .cta h2 { color: #5cb85c; margin-top: 0; }
        .cta-btn {
            display: inline-block;
            background: linear-gradient(135deg, #4a9d4a 0%, #5cb85c 100%);
            color: #faf3e8 !important;
            text-decoration: none;
            padding: 14px 32px;
            border-radius: 5px;
            font-size: 18px;
        }
        .contact-details { display: none; margin-top: 12px; }
        .phone { font-size: 22px; font-weight: bold; color: #5cb85c; }
        @media (max-width: 600px) {
            nav a { margin: 0 15px; font-size: 16px; }
            .project-grid { grid-template-columns: 1fr; }
        }
    </style>
{% endblock %}

{% block content %}
    <div class="container">
        <div class="page-header">
            <h1><img class="logo" src="/images/logo/tts-logo-only-green.svg" alt="Toad Town Services Logo"> Projects</h1>
            <p>A few examples of the kinds of problems I help people solve.</p>
        </div>

        <div class="project-grid">
            {% for project in projects.projects %}
            <div class="project-card">
                {% if project.image %}
                <img src="{{ project.image }}" alt="{{ project.imageAlt }}" loading="lazy">
                {% endif %}
                <div class="project-body">
                    <div class="project-category">{{ project.category }}</div>
                    <h2>{{ project.title }}</h2>
                    <h3>What they needed</h3>
                    <p>{{ project.need }}</p>
                    <h3>What I did</h3>
                    <p>{{ project.did }}</p>
                    <h3>The result</h3>
                    <p>{{ project.result }}</p>
                    {% if project.link %}
                    <p style="margin-top: 12px;"><a href="{{ project.link }}" target="_blank" rel="noopener">{{ project.linkText }} &rarr;</a></p>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>

        <div class="cta">
            <h2>Have Something Similar Going On?</h2>
            <p>Tell me a little about it and I'll get back to you, usually within a day. No pressure, and the first conversation is free.</p>
            <p><a class="cta-btn" href="/contact.html">Tell me about it &rarr;</a></p>
            <div class="reveal-small">
                <label>
                    <input type="checkbox" id="revealContact" onchange="toggleContact()">
                    Prefer to call or email? Show my contact info
                </label>
                <div class="contact-details" id="contactDetails">
                    <div class="phone" id="phoneDisplay"></div>
                    <p><strong>Email:</strong> <span id="emailDisplay"></span></p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
